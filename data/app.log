  src = '<!DOCTYPE html>\n<html lang="pt-BR">\n<head>\n    <meta charset="UTF-8">\n    <style>/* ============================================\n   CSS para Relatório PDF - Controle de Obras\n   Motor: WeasyPrint\n   ============================================ */\n\n@page {\n    size: A4;\n    margin: 1.5cm 1.5cm 2cm 1.5cm;\n}\n\n@page :first {\n    margin-top: 1.5cm;\n}\n\n/* ==================== BASE ==================== */\n\n* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n}\n\nbody {\n    font-family: \'Helvetica\', \'Arial\', sans-serif;\n    font-size: 10pt;\n    color: #1E293B;\n    line-height: 1.4;\n}\n\n/* ==================== CABEÇALHO ==================== */\n\n.cabecalho {\n    margin-bottom: 16pt;\n    border-bottom: 2px solid #1B2A4A;\n    padding-bottom: 10pt;\n}\n\n.cabecalho h1 {\n    font-size: 18pt;\n    color: #1B2A4A;\n    margin: 0 0 4pt 0;\n    font-weight: 700;\n    letter-spacing: 0.5pt;\n}\n\n.cabecalho h2 {\n    font-size: 13pt;\n    color: #1B2A4A;\n    font-weight: 700;\n    margin: 0 0 10pt 0;\n}\n\n.info-obra {\n    display: flex;\n    gap: 20pt;\n    margin: 8pt 0;\n}\n\n.info-obra .col {\n    flex: 1;\n}\n\n.info-obra p {\n    margin: 3pt 0;\n    font-size: 10pt;\n    color: #334155;\n}\n\n.info-obra strong {\n    color: #1E293B;\n}\n\n.emissao {\n    text-align: right;\n    font-size: 9pt;\n    color: #64748B;\n    margin: 8pt 0 0 0;\n    font-style: italic;\n}\n\n/* ==================== SEÇÕES ==================== */\n\n.secao {\n    margin-bottom: 16pt;\n    page-break-inside: avoid;\n}\n\n.secao h3 {\n    font-size: 12pt;\n    color: #1B2A4A;\n    margin: 0 0 8pt 0;\n    padding-bottom: 4pt;\n    border-bottom: 1px solid #E2E8F0;\n    font-weight: 700;\n}\n\n/* ==================== TABELAS ==================== */\n\ntable {\n    width: 100%;\n    border-collapse: collapse;\n    margin: 8pt 0;\n    font-size: 9pt;\n}\n\nthead th {\n    background-color: #1B2A4A;\n    color: white;\n    padding: 7pt 8pt;\n    tex