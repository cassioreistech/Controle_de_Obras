  src = '<!DOCTYPE html>\n<html lang="pt-BR">\n<head>\n    <meta charset="UTF-8">\n    <style>/* ============================================\n   CSS para Relatório PDF - Controle de Obras\n   Motor: xhtml2pdf\n   ============================================ */\n\n@page {\n    size: A4;\n    margin: 1.5cm 1.5cm 2cm 1.5cm;\n}\n\n/* ==================== BASE ==================== */\n\nbody {\n    font-family: Helvetica, Arial, sans-serif;\n    font-size: 10pt;\n    color: #374151;\n    line-height: 1.4;\n}\n\n/* ==================== CABEÇALHO ==================== */\n\n.cabecalho {\n    margin-bottom: 16pt;\n    border-bottom: 2pt solid #9CA3AF;\n    padding-bottom: 10pt;\n    text-align: center;\n}\n\n.cabecalho h1 {\n    font-size: 18pt;\n    color: #374151;\n    margin: 0 0 4pt 0;\n    font-weight: 700;\n    letter-spacing: 0.5pt;\n    text-align: center;\n}\n\n.cabecalho h2 {\n    font-size: 13pt;\n    color: #6B7280;\n    font-weight: 600;\n    margin: 0 0 10pt 0;\n    text-align: center;\n}\n\n/* ==================== INFO OBRA ==================== */\n\n.info-obra {\n    width: 100%;\n    margin: 8pt 0;\n}\n\n.info-obra table {\n    width: 100%;\n    border-collapse: collapse;\n    border: none;\n}\n\n.info-obra td {\n    padding: 2pt 4pt;\n    border: none;\n    vertical-align: top;\n    font-size: 10pt;\n    color: #4B5563;\n    width: 50%;\n}\n\n.info-obra strong {\n    color: #374151;\n}\n\n.emissao {\n    text-align: right;\n    font-size: 9pt;\n    color: #9CA3AF;\n    margin: 8pt 0 0 0;\n    font-style: italic;\n}\n\n/* ==================== SEÇÕES ==================== */\n\n.secao {\n    margin-bottom: 16pt;\n}\n\n.secao h3 {\n    font-size: 12pt;\n    color: #4B5563;\n    margin: 0 0 8pt 0;\n    padding-bottom: 4pt;\n    border-bottom: 1pt solid #E5E7EB;\n    font-weight: 700;\n}\n\n/* ==================== TABELAS ==================== */\n\ntable {\n    width: 100%;\n    border-collapse: collapse;\n    margin: 8pt 0;\n    font-size: 9pt;\n}\n\nthead th {\n    background-color: #6B7280;\n    color: white;\n    padding: 5pt 3pt;\n    text-align: left;\n    font-weight: 600;\n    font-size: 9pt;\n}\n\ntbody td {\n    padding: 4pt 3pt;\n    border-bottom: 1pt solid #E5E7EB;\n    vertical-align: middle;\n}\n\ntbody tr:nth-child(even) td {\n    background-color: #F9FAFB;\n}\n\n.direita {\n    text-align: right;\n}\n\n/* ==================== TABELA RESUMO ==================== */\n\n.tabela-resumo {\n    margin: 10pt 0;\n}\n\n.tabela-resumo thead th {\n    text-align: center;\n    padding: 8pt;\n    font-size: 9pt;\n}\n\n.tabela-resumo tbody td {\n    text-align: center;\n    font-size: 11pt;\n    font-weight: 700;\n    padding: 12pt 8pt;\n    background-color: #F9FAFB;\n}\n\n/* ==================== RODAPÉ ==================== */\n\n.footer-table {\n    width: 100%;\n    border-top: 1pt solid #E5E7EB;\n    padding-top: 6pt;\n    margin-top: 16pt;\n}\n\n.footer-table td {\n    font-size: 8pt;\n    color: #9CA3AF;\n    text-align: center;\n    border: none;\n    padding: 4pt;\n}\n\n/* ==================== UTILITÁRIOS ==================== */\n\n.page-break {\n    page-break-before: always;\n}\n\n.nao-quebrar {\n    page-break-inside: avoid;\n}\n\n/* ==================== ASSINATURA ==================== */\n\n.assinatura {\n    margin-top: 40pt;\n    text-align: center;\n}\n\n.assinatura-texto {\n    font-size: 10pt;\n    color: #374151;\n    margin-bottom: 4pt;\n}\n\n.assinatura-nome {\n    font-size: 11pt;\n    font-weight: 700;\n    color: #374151;\n    margin: 0;\n}\n\n.assinatura-cargo {\n    font-size: 9pt;\n    color: #9CA3AF;\n    margin: 2pt 0 0 0;\n}\n</style>\n</head>\n<body>\n    <!-- CABEÇALHO -->\n    <header class="cabecalho">\n        <h1>RELATÓRIO DA OBRA</h1>\n        <h2>Construção de uma Ponto de 500 m</h2>\n\n        <div class="info-obra">\n            <table>\n                <tr>\n                    <td><strong>Código:</strong> 02</td>\n                    <td><strong>Cliente:</strong> Prefeitura Muncipal de Baldim</td>\n                </tr>\n                <tr>\n                    <td><strong>Local:</strong> Baldim MG</td>\n                    <td><strong>Engenheiro:</strong> Fernado Alves</td>\n                </tr>\n            </table>\n        </div>\n\n        <p class="emissao">Emissão: 17/08/2026</p>\n    </header>\n\n    <!-- RESUMO FINANCEIRO -->\n    <section class="secao">\n        <h3>RESUMO FINANCEIRO</h3>\n        <table class="tabela-resumo">\n            <thead>\n                <tr>\n                    <th>Valor Contratado</th>\n                    <th>Total Aditivos</th>\n                    <th>Total Gasto</th>\n                    <th>Valor Líquido</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>R$ 301.215.230,00</td>\n                    <td>R$ 1.524.300,00</td>\n                    <td>R$ 79.383,50</td>\n                    <td>R$ 302.660.146,50</td>\n                </tr>\n            </tbody>\n        </table>\n    </section>\n\n    <!-- ADITIVOS -->\n    \n    <section class="secao">\n        <h3>ADITIVOS</h3>\n        <table width="100%" repeat="1">\n            <thead>\n                <tr>\n                    <th width="80pt">Data</th>\n                    <th width="300pt">Descrição</th>\n                    <th width="110pt" style="text-align: right;">Valor</th>\n                </tr>\n            </thead>\n            <tbody>\n                \n                <tr>\n                    <td width="80pt" style="vertical-align: middle; padding-left: 5px; padding-right: 5px;">17/08/2026</td>\n                    <td width="300pt" style="vertical-align: middle; padding-left: 5px; padding-right: 5px;">Aumento</td>\n                    <td width="110pt" style="vertical-align: middle; text-align: right; white-space: nowrap; padding-left: 5px; padding-right: 5px;">R$ 1.524.300,00</td>\n                </tr>\n                \n            </tbody>\n        </table>\n  